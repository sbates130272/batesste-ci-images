# Ignore any PA token files.
*.token
# Ignore the .env file.
.env
# Local scratch overlay on images.yml. Never checked in: a published image
# must always match the spec in the tree.
images.local.yml
# Python virtual environment
.venv/
# Cached cloud images (downloaded in CI)
**/cloud-image-cache/*.img
# Guest payload extracted from ubuntu-qcow2-gen for the compose stack
compose/vm/
# AMD corporate root CA (ZScaler) - local only, not committed
**/amd-root-ca.crt
# VSCode 
.vscode
# Python cache
__pycache__/

# pyspelling compiled dictionary (.spellcheck.yaml output)
wordlist.dic

# Guest payloads exported by `ci-images-tool.py build` (qcow2, SSH keys,
# vm-info.json). Multi-GB; published as ORAS artifacts, never committed.
output/

# The generated half of the bake definition, written by `ci-images-tool.py
# bake`. Derived from images.yml and the git revision, so committing it would
# create a second copy of every pin that can go stale -- and it carries this
# build's tags, which are dated. docker-bake.hcl, the hand-written half, is
# committed.
bake-targets.json

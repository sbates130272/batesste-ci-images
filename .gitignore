# Ignore any PA token files.
*.token
# Ignore the .env file.
.env
# Local scratch overlay on images.yml. Never checked in: a published image
# must always match the spec in the tree.
images.local.yml
# Python virtual environment
.venv/
# Cloud images left behind by the guest builds this repo used to run
**/cloud-image-cache/
# The guest pulled for the compose stack; see compose/docker-compose.yml
compose/vm/
# AMD corporate root CA (ZScaler) - local only, not committed
**/amd-root-ca.crt

# A guest SSH keypair from when this repo built guests. Nothing reads it now,
# but it is a private key and this repository is public: never committed.
common/ssh/
# VSCode 
.vscode
# Python cache
__pycache__/

# pyspelling compiled dictionary (.spellcheck.yaml output)
wordlist.dic

# Slurm build logs, and anything else a local run leaves behind.
output/

# The generated half of the bake definition, written by `ci-images-tool.py
# bake`. Derived from images.yml and the git revision, so committing it would
# create a second copy of every pin that can go stale -- and it carries this
# build's tags, which are dated. docker-bake.hcl, the hand-written half, is
# committed.
bake-targets.json

# Generated by the gh-work workflow audit
github-workflow-cleanup.md

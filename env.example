# Template for .env, which is not checked in. It holds the two things
# images.yml cannot: secrets, and settings that belong to this machine rather
# than to the repository.
#
# Everything about *what* gets built -- pinned versions, build args, tag
# variants, labels, the base chain -- lives in images.yml. Nothing is
# duplicated here, so nothing can drift. Values below are left blank
# deliberately: an empty value means "unset", so the images.yml default
# applies.
#
# Any var declared in images.yml can still be overridden here for a one-off
# local build, using the env name given in its entry. Read the current values
# back with `./ci-images-tool.py config <image>`. A variant's own pins are
# immune to that override -- ubuntu-cuda-rocm-fio@async-hipfile exists to be
# built against exactly that ref.

# OCI registry. REGISTRY_PASSWORD is the reason this file is gitignored; it can
# be a token or a path to a file containing one. The other three default from
# images.yml and only need setting to publish somewhere else.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY=
REGISTRY_IMAGE=

# Base tag. auto = today's UTC date in ISO basic form (e.g. 20260526);
# a semver such as 1.1.0 also publishes the rolling 1.1 and latest
# aliases. A variant naming the payload (e.g. rocm10.0-cuda13.4) is
# appended automatically -- see "ci-images-tool.py tags <image>".
IMAGE_TAG=auto

# Build directory, if not the repository root.
WORKDIR=

# Read at container run time by ubuntu-qemu-libvfio-user's entrypoint, not at
# build time. The VM identity itself (USERNAME, VM_NAME, PASSWORD) is baked in
# at build time and is declared in images.yml.
SSH_PORT=2222
VCPUS=2
VMEM=4096
QEMU_PATH=/opt/qemu/bin/

# Attach a vfio-user device server to the VM (e.g. the rocjitsu socket from
# compose/docker-compose.yml). Leave unset to boot the VM without one.
# Setting this also switches the VM to a shared memfd memory backend, which the
# vfio-user server needs in order to reach guest RAM. amd64 only.
VFIO_USER_SOCKET=

# Base image to layer fio on. Leave empty to use this run's own
# ubuntu-cuda-rocm tag; set to pin a published base instead.
FIO_BASE_IMAGE=

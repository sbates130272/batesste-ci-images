# VM Configuration
# VM_NAME defaults to ${USERNAME}-ci-vm if not specified
USERNAME=batesste
VM_NAME=
PASSWORD=changeme
SSH_PORT=2222
VCPUS=2
VMEM=4096

# QEMU Configuration
QEMU_PATH=/opt/qemu/bin/

# QEMU source repository
# Default: https://gitlab.com/qemu-project/qemu.git
# Set to a fork URL to build from a different repo
QEMU_REPO=

# Repository Git refs (tags or commit hashes for
# reproducible builds)
# QEMU: use a release tag (e.g. v11.1.1) or commit
# hash; tags are typically stable but not as strictly
# immutable as a full commit SHA
# Tags: git ls-remote --tags <QEMU_REPO URL>
QEMU_COMMIT=v11.1.1
# libvfio-user: pin to a commit hash (no formal releases)
# Latest: git ls-remote https://gitlab.com/qemu-project/libvfio-user.git HEAD
LIBVFIO_USER_COMMIT=323f4cb6cddc3713fb7aebe44436f28b28b5413a

# qemu-minimal Configuration
# Leave blank to use the defaults pinned in ci-images-tool.py
# (repo below at commit f88d4561031b80aec4441352d221c42ede30848b);
# the VM disk image is built with qemu-tool gen-vm.
# Set QEMU_MINIMAL_REPO=none to skip the VM build entirely.
# Latest: git ls-remote https://github.com/sbates130272/qemu-minimal.git HEAD
QEMU_MINIMAL_PATH=/build/qemu-minimal
QEMU_MINIMAL_COMMIT=
QEMU_MINIMAL_REPO=

# Use KVM acceleration for the VM build (default true).
# Requires /dev/kvm on the build host; the build falls back
# to TCG emulation when it is unavailable.
KVM=true

# Attach a vfio-user device server to the VM (e.g. the rocjitsu socket from
# compose/docker-compose.yml). Leave unset to boot the VM without one.
# Setting this also switches the VM to a shared memfd memory backend, which the
# vfio-user server needs in order to reach guest RAM. amd64 only.
VFIO_USER_SOCKET=

# OCI Registry Configuration (for pushing Docker images)
# Leave empty to skip pushing
REGISTRY=docker.io
REGISTRY_IMAGE=batesste-ci-images
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# auto = today's date (e.g. may-26-2026); use "latest" to pin that tag
IMAGE_TAG=auto

# ubuntu-cuda-rocm (optional)
CUDA_VERSION=13-3
ROCM_VERSION=7.14
# ROCM_STREAM: 'therock' (repo.amd.com, ROCm 7.13+) or 'legacy' (repo.radeon.com, ROCm <=7.2)
ROCM_STREAM=therock

# ubuntu-rocm-ernic: pin to a specific commit SHA
ROCM_ERNIC_COMMIT=e65d71539e62403f278c36055c7fe1e97d86202a

# ubuntu-rocm-rocjitsu: source repo, branch, and pinned commit SHA
ROCM_ROCJITSU_REPO=https://github.com/ROCm/rocm-systems.git
ROCM_ROCJITSU_BRANCH=develop
ROCM_ROCJITSU_COMMIT=5591761e3865fb92f3b82e2f18106927af77d34a

# ubuntu-cuda-rocm-fio: source repo and pinned commit SHA
# Must be a master commit -- the libhipfile engine is not in any fio tag yet
FIO_REPO=https://github.com/axboe/fio.git
FIO_COMMIT=ae35a58399b28edf857f7ebc43b3eb40d86ac29b
# Base image to layer fio on. Leave empty to use this run's own
# ubuntu-cuda-rocm tag; set to pin a published base instead.
FIO_BASE_IMAGE=


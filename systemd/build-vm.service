[Unit]
Description=Build the CI images and push them to the registry daily
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/batesste-ci-images/.env
WorkingDirectory=/opt/batesste-ci-images
# --push is required and not decorative: `build` publishes nothing without it.
# This unit is the one caller in the tree that depends on that -- it exists to
# keep the registry refreshed nightly, and without the flag it would build,
# exit 0, and quietly stop publishing, with one dim line in the journal as the
# only sign.
ExecStart=/opt/batesste-ci-images/.venv/bin/python /opt/batesste-ci-images/ci-images-tool.py build --push
StandardOutput=journal
StandardError=journal


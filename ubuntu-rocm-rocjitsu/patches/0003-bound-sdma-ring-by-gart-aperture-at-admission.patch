@@ -11,6 +11,7 @@
 
 #include <algorithm>
 #include <format>
+#include <optional>
 #include <utility>
 
 namespace rocjitsu {
@@ -144,6 +145,23 @@ amdgpu::QueueSubmissionStatus SdmaBlockModel::process_queue(Queue &queue, uint64
       !queue.address_space || soc_ == nullptr || queue_binding_factory_ == nullptr)
     return amdgpu::QueueSubmissionStatus::Faulted;
 
+  // VMID 0 is bounded by the programmed GART aperture. The translator lets an
+  // out-of-aperture address through to local memory, because a VMID-0 engine
+  // legitimately reaches page tables and indirect buffers sitting in the frame
+  // buffer -- but a ring is not one of those. A ring outside the aperture is a
+  // misprogrammed queue, so refuse it here rather than reinterpreting it as a
+  // local-memory address.
+  const std::optional<amdgpu::GartConfig> gart = soc_->gpu_vm().gart_config();
+  if (!gart || queue.ring_base < gart->aperture_start ||
+      queue.ring_base > gart->aperture_end ||
+      queue.ring_bytes - 1 > gart->aperture_end - queue.ring_base) {
+    queue.faulted = true;
+    util::Logger::warn(std::format(
+        "{}: SDMA{} ring [{:#x}+{:#x}] lies outside the GART aperture", registers_.owner(),
+        queue.engine, queue.ring_base, queue.ring_bytes));
+    return amdgpu::QueueSubmissionStatus::Faulted;
+  }
+
   if (!queue.queue_handle) {
     queue.queue_handle = soc_->queue_registry().register_queue({
         .identity = {.address_space = queue.address_space,

-TEST(GpuVmTranslation, Gfx12GartFaultsOutsideTheConfiguredAperture) {
+// The GART aperture says which addresses are *translated*, not which addresses
+// a GART-bound engine may reach. Kernel SDMA rings bind to the single GART
+// address space (GpuVm::gart_address_space()), and the driver legitimately
+// points them at VRAM: rings, indirect buffers and the page-table stores the
+// driver itself issues all land in the frame buffer, outside the aperture. A
+// VMID-0 engine addressing the frame buffer directly is a pass-through, so an
+// out-of-aperture access resolves to VmMemoryDomain::Local at the same address,
+// clipped so the next byte re-enters the walk at the aperture boundary.
+TEST(GpuVmTranslation, Gfx12GartPassesThroughAccessesOutsideTheConfiguredAperture) {
   auto physical = std::make_shared<TestPhysicalMemory>();
   constexpr uint64_t table = 0x1000;

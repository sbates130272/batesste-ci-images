+// amdgpu_gmc_pd_addr() ORs the PDE control bits into PAGE_TABLE_BASE_ADDR
+// before the driver writes it, so a real GART root arrives with its low bits
+// set (0x6900005 on gfx1250) and is never 4 KiB aligned. Validate the masked
+// root, not the raw register, or every real publication is refused.
+TEST(GpuVmTranslation, GpuVmAcceptsAGartRootCarryingPdeFlagBits) {
+  GpuVm gpu_vm;
+  auto physical = std::make_shared<TestPhysicalMemory>();
+  ASSERT_TRUE(gpu_vm.initialize_gart_address_space());
+
+  EXPECT_TRUE(gpu_vm.publish_gart(
+      {.page_table_base = 0x1005, .aperture_start = 0x10000, .aperture_end = 0x10fff}, physical));
+  ASSERT_TRUE(gpu_vm.lookup(gpu_vm.gart_address_space()));
+  EXPECT_TRUE(gpu_vm.lookup(gpu_vm.gart_address_space())->ready);
+
+  // Accepting flag bits must not also accept a root that overruns the
+  // configured physical address width.
+  EXPECT_FALSE(gpu_vm.publish_gart({.page_table_base = (uint64_t{1} << 60) | 0x1005,
+                                    .aperture_start = 0x10000,
+                                    .aperture_end = 0x10fff},
+                                   physical));
+}

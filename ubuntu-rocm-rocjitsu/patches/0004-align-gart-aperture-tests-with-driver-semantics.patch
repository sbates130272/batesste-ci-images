   ASSERT_TRUE(system);
@@ -524,8 +537,10 @@ TEST(GpuVmTranslation, Gfx12GartUsesByteBoundariesAndPtePermissions) {
   EXPECT_FALSE(last_byte.translation.permissions.executable);
